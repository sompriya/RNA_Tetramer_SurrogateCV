cos11: MATHEVAL ARG=zeta_2 FUNC=cos(x) PERIODIC=NO
chi_2: TORSION ATOMS=@chi-2
cos12: MATHEVAL ARG=chi_2 FUNC=cos(x) PERIODIC=NO
 
# Residue 3
#----------------
alpha_3: TORSION ATOMS=@alpha-3
cos13: MATHEVAL ARG=alpha_3 FUNC=cos(x) PERIODIC=NO
beta_3: TORSION ATOMS=@beta-3
cos14: MATHEVAL ARG=beta_3 FUNC=cos(x) PERIODIC=NO
gamma_3: TORSION ATOMS=@gamma-3
cos15: MATHEVAL ARG=gamma_3 FUNC=cos(x) PERIODIC=NO
delta_3: TORSION ATOMS=@delta-3
cos16: MATHEVAL ARG=delta_3 FUNC=cos(x) PERIODIC=NO
epsilon_3: TORSION ATOMS=@epsilon-3
cos17: MATHEVAL ARG=epsilon_3 FUNC=cos(x) PERIODIC=NO

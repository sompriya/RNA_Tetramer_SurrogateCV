cos19: MATHEVAL ARG=chi_3 FUNC=cos(x) PERIODIC=NO
 
# Residue 4
#----------------
alpha_4: TORSION ATOMS=@alpha-4
cos20: MATHEVAL ARG=alpha_4 FUNC=cos(x) PERIODIC=NO
beta_4: TORSION ATOMS=@beta-4
cos21: MATHEVAL ARG=beta_4 FUNC=cos(x) PERIODIC=NO
gamma_4: TORSION ATOMS=@gamma-4
cos22: MATHEVAL ARG=gamma_4 FUNC=cos(x) PERIODIC=NO
delta_4: TORSION ATOMS=@delta-4
cos23: MATHEVAL ARG=delta_4 FUNC=cos(x) PERIODIC=NO
chi_4: TORSION ATOMS=@chi-4
cos24: MATHEVAL ARG=chi_4 FUNC=cos(x) PERIODIC=NO


lasso_node0: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos11,cos12,cos13,cos15,cos17,cos18,cos19,cos20,cos22,cos23,cos24 COEFFICIENTS=0.0004,0.0405,-0.1029,-0.0410,-0.4965,-0.0153,-0.0230,0.0671,0.0173,-0.0185,0.0023,-0.0034,0.0009,-0.0024,0.1161,-0.0188,-0.0022,-0.0171,-0.0166 PERIODIC=NO
 
lassoCV_node0: MATHEVAL ARG=lasso_node0 FUNC=x+0.1775 PERIODIC=NO

lasso_node1: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 COEFFICIENTS=-0.0017,-0.0167,0.0064,-0.0154,0.0337,-0.0567,-0.0364,0.0648,0.0086,0.0140,-0.0160,-0.0367,-0.0165,0.0300,0.0431,0.0716,0.0322,0.0481,0.0167,-0.2162,0.2782,0.1587,-0.2513,0.1907 PERIODIC=NO
 
lassoCV_node1: MATHEVAL ARG=lasso_node1 FUNC=x-0.0876 PERIODIC=NO

ene: ENERGY 
ecv: ECV_MULTITHERMAL ARG=ene TEMP_MIN=275 TEMP_MAX=325 TEMP_STEPS=6 
opes: OPES_EXPANDED ARG=ecv.* PACE=500



PRINT STRIDE=500 ARG=lassoCV_node0,lassoCV_node1,ene,ecv.*,opes.*,cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 FILE=COLVAR_multiT_new


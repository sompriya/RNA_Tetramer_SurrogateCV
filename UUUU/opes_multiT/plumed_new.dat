lasso_node0: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 COEFFICIENTS=0.0024,0.0176,-0.0479,0.0160,-0.1031,0.0022,-0.0206,0.0403,0.2759,-0.1770,0.0418,0.0062,-0.0741,-0.0178,0.4178,0.0876,-0.0745,0.0100,0.0089,-0.0192,0.0025,0.0580,-0.0100,-0.0273 PERIODIC=NO
 
lassoCV_node0: MATHEVAL ARG=lasso_node0 FUNC=x+0.0621 PERIODIC=NO

lasso_node1: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 COEFFICIENTS=0.0061,-0.0227,0.0094,-0.0006,0.0749,0.0080,0.0255,-0.3013,-0.0579,0.0556,-0.0403,-0.0309,-0.0632,-0.0179,0.3046,-0.0649,-0.0041,0.0089,-0.0414,-0.0104,0.0478,-0.0533,0.0043,0.0155 PERIODIC=NO
 
lassoCV_node1: MATHEVAL ARG=lasso_node1 FUNC=x-0.1657 PERIODIC=NO

ene: ENERGY 
ecv: ECV_MULTITHERMAL ARG=ene TEMP_MIN=275 TEMP_MAX=355 TEMP_STEPS=9 
opes: OPES_EXPANDED ARG=ecv.* PACE=500



PRINT STRIDE=500 ARG=lassoCV_node0,lassoCV_node1,ene,ecv.*,opes.*,cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 FILE=COLVAR_multiT_new


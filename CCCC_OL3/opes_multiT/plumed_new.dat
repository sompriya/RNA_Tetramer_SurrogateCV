lasso_node0: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 COEFFICIENTS=0.0096,-0.0318,0.2867,0.0166,0.3234,-0.0416,-0.1109,0.0033,0.0780,-0.0452,-0.1136,-0.0518,0.0127,-0.0995,0.0222,0.0065,0.1842,0.1355,0.2086,0.0724,0.0498,0.0334,-0.0063,0.0898 PERIODIC=NO
 
lassoCV_node0: MATHEVAL ARG=lasso_node0 FUNC=x-0.0456 PERIODIC=NO

lasso_node1: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 COEFFICIENTS=-0.0091,0.0389,-0.0128,0.0840,-0.1183,-0.0094,0.0845,0.0215,0.0310,0.0007,-0.0799,-0.0389,-0.1001,0.1092,-0.0429,0.1153,0.0128,0.3211,0.0433,-0.0873,0.0014,-0.0183,-0.0366 PERIODIC=NO
 
lassoCV_node1: MATHEVAL ARG=lasso_node1 FUNC=x-0.5673 PERIODIC=NO

ene: ENERGY 
ecv: ECV_MULTITHERMAL ARG=ene TEMP_MIN=275 TEMP_MAX=325 TEMP_STEPS=6 
opes: OPES_EXPANDED ARG=ecv.* PACE=500



PRINT STRIDE=500 ARG=lassoCV_node0,lassoCV_node1,ene,ecv.*,opes.*,cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 FILE=COLVAR_multiT_new


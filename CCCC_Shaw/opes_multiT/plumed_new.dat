lasso_node0: COMBINE ARG=cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos20,cos21,cos22,cos23,cos24 COEFFICIENTS=-0.0083,0.0514,-0.0188,0.0215,-0.3050,-0.0750,-0.0208,0.0710,0.1212,0.1941,-0.0228,0.0036,0.0117,-0.3798,-0.1469,0.0422,-0.0443,0.0363,0.0094,0.0228,-0.0627,0.0892,0.0068 PERIODIC=NO
 
lassoCV_node0: MATHEVAL ARG=lasso_node0 FUNC=x-0.2839 PERIODIC=NO

lasso_node1: COMBINE ARG=cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos22,cos23,cos24 COEFFICIENTS=0.0342,0.0004,0.0866,-0.0617,0.1613,-0.0958,-0.0719,0.2224,-0.3223,0.0201,-0.2142,-0.0048,-0.0129,0.1813,0.2613,0.0790,0.0329,-0.4125,-0.0574,-0.0318,-0.0143,0.0701 PERIODIC=NO
 
lassoCV_node1: MATHEVAL ARG=lasso_node1 FUNC=x-0.5868 PERIODIC=NO

ene: ENERGY 
ecv: ECV_MULTITHERMAL ARG=ene TEMP_MIN=275 TEMP_MAX=325 TEMP_STEPS=6 
opes: OPES_EXPANDED ARG=ecv.* PACE=500



PRINT STRIDE=500 ARG=lassoCV_node0,lassoCV_node1,ene,ecv.*,opes.*,cos1,cos2,cos3,cos4,cos5,cos6,cos7,cos8,cos9,cos10,cos11,cos12,cos13,cos14,cos15,cos16,cos17,cos18,cos19,cos20,cos21,cos22,cos23,cos24 FILE=COLVAR_multiT_new

